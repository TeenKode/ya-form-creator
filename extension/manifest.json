{
  "manifest_version": 3,
  "name": "YaFormCreator — создание Яндекс Форм",
  "version": "1.5.1",
  "description": "Передаёт анкету с сайта YaFormCreator в Яндекс Формы после подтверждения. Токен остаётся в расширении.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://api.forms.yandex.net/*",
    "https://oauth.yandex.ru/*",
    "https://api360.yandex.net/*",
    "https://organization-manager.api.cloud.yandex.net/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Открыть YaFormCreator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teenkode.github.io/ya-form-creator/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.forms.yandex.net https://oauth.yandex.ru https://api360.yandex.net https://organization-manager.api.cloud.yandex.net"
  }
}
